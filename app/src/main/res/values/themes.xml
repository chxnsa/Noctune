<resources>
    <!-- Base theme -->
    <style name="Theme.Noctune" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/noctune_yellow</item>
        <item name="colorSecondary">@color/noctune_red</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.Noctune.Dark" parent="Theme.Noctune">
        <item name="android:windowBackground">@color/bg_brutalist_dark</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>

    <!-- Light Theme[cite: 20] -->
    <style name="Theme.Noctune.Light" parent="Theme.Noctune">
        <item name="android:windowBackground">@color/bg_brutalist_light</item>
        <item name="android:statusBarColor">@color/noctune_yellow</item>
    </style>

    <!-- Gaya Tombol Brutalist: Kotak total, border tebal, tanpa shadow halus -->
    <style name="BrutalistButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">3dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:elevation">0dp</item>
        <item name="stateListAnimator">@null</item>
    </style>
</resources>