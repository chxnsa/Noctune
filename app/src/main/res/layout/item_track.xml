<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/bg_surface"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <!-- Nomor Urut Track Ledger -->
    <TextView
        android:id="@+id/tv_track_number"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="01"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:fontFamily="@font/space_mono"/>

    <!-- Track Image -->
    <ImageView
        android:id="@+id/iv_track_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:background="@color/border_color"
        android:contentDescription="Track Image"/>

    <!-- Detail Meta Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tv_track_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/bebas_neue"
            android:textAllCaps="true"
            android:letterSpacing="0.01"/>

        <TextView
            android:id="@+id/tv_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/space_mono"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Playcount (Ganti dari duration agar sesuai dengan Adapter) -->
    <TextView
        android:id="@+id/tv_playcount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 PLAYS"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:fontFamily="@font/space_mono"
        android:textStyle="bold"
        android:layout_marginEnd="16dp"/>

</LinearLayout>