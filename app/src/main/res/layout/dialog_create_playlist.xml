<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:strokeWidth="3"
    android:padding="20dp"
    android:layout_margin="16dp"
    style="@style/BrutalistButton"
    android:elevation="0dp">


    <EditText
        android:id="@+id/et_playlist_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/brutalist_flat_card"
        android:fontFamily="@font/space_mono"
        android:hint="INPUT PLAYLIST NAME..."
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="CANCEL"
            android:layout_marginRight="4dp"
            app:backgroundTint="@color/brand_red"
            android:textColor="#FFFFFF"
            style="@style/BrutalistButton"/>

        <Button
            android:id="@+id/btn_create"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="SAVE"
            android:layout_marginLeft="4dp"
            app:backgroundTint="@color/brand_yellow"
            android:textColor="#000000"
            style="@style/BrutalistButton"/>
    </LinearLayout>
</LinearLayout>