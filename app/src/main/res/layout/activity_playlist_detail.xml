<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_yellow"
        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp">

        <TextView
            android:id="@+id/tv_back_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@color/bg_surface"
            android:text="← BACK"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/space_mono"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_playlist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="PLAYLIST SYSTEM"
            android:textColor="#000000"
            android:textSize="26sp"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.02"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/border_color"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/bg_surface">

        <TextView
            android:id="@+id/tv_playlist_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 TRACKS"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/space_mono"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/border_color"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_surface">

        <TextView
            android:id="@+id/tv_playlist_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@color/bg_surface"
            android:padding="24dp"
            android:text="Add tracks to this directory via Home or Explore console."
            android:textColor="@color/brand_red"
            android:textSize="13sp"
            android:fontFamily="@font/space_mono"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_playlist_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main" />
    </FrameLayout>

</LinearLayout>