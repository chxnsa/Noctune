<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/border_color"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARCHIVE . VOL_04"
            android:textColor="@color/brand_yellow"
            android:textSize="12sp"
            android:fontFamily="@font/space_mono"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR FAVORITES"
            android:textColor="@color/bg_surface"
            android:textSize="40sp"
            android:fontFamily="@font/bebas_neue"
            android:lineSpacingMultiplier="0.85"
            android:letterSpacing="0.02"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/border_color"/>

    <!-- Geometric Tab Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/border_color">

        <LinearLayout
            android:id="@+id/tab_faves"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@color/brand_yellow">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 / TRACKS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/space_mono"/>
        </LinearLayout>

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/border_color"/>

        <LinearLayout
            android:id="@+id/tab_playlists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@color/bg_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:text="02 / PLAYLISTS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/space_mono"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/border_color"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/border_color">

        <LinearLayout
            android:id="@+id/view_faves_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_main"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="80dp"
                android:background="@color/bg_surface"
                android:padding="24dp"
                android:text="[NOTICE_01: DIRECTORY_EMPTY]\n\nNo tracks have been registered as favorite. Tag items from core console."
                android:textColor="@color/brand_red"
                android:textSize="13sp"
                android:fontFamily="@font/space_mono"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_faves"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/view_playlists_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_main"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_new_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/brand_yellow"
                android:text="+ CREATE NEW DIRECTORY"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/space_mono"
                android:gravity="center"
                android:padding="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/border_color"/>

            <TextView
                android:id="@+id/tv_empty_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="80dp"
                android:background="@color/bg_surface"
                android:padding="24dp"
                android:text="[NOTICE_02: NO_PLAYLISTS_FOUND]\n\nInitialization needed. Tap the bar above to create a new music container."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/space_mono"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_playlists"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>