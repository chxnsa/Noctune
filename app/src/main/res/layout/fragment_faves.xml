<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header Block Hitam Pekat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/border_color"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARCHIVE . VOL_04"
                android:textColor="@color/brand_yellow"
                android:textSize="12sp"
                android:fontFamily="@font/space_mono"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR\nFAVORITES"
                android:textColor="@color/bg_surface"
                android:textSize="40sp"
                android:fontFamily="@font/bebas_neue"
                android:lineSpacingMultiplier="0.85"/>
        </LinearLayout>

        <!-- Shuffle Button Berbentuk Kotak Kuning Blok Tanpa Radius -->
        <Button
            android:id="@+id/btn_shuffle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHUFFLE\nALL"
            android:textSize="12sp"
            android:fontFamily="@font/space_mono"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_yellow"
            android:textColor="#000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:cornerRadius="0dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/border_color"/>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NO FAVORITES RECORDED"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/space_mono"
        android:gravity="center"
        android:layout_marginTop="60dp"
        android:visibility="gone"/>

    <!-- List Ledger Lagu-lagu Favorit -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_faves"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"/>

</LinearLayout>