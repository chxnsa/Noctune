<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="EXPLORE HUB"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="@font/bebas_neue"/>

    <!-- Genre chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/ll_genre_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>

    </HorizontalScrollView>

    <!-- Tombol retry -->
    <Button
        android:id="@+id/btn_retry_explore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="RETRY"
        android:backgroundTint="@color/brand_yellow"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/space_mono"
        android:visibility="gone"/>

    <!-- Konten scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Section: TOP ARTISTS (horizontal) -->
            <TextView
                android:id="@+id/tv_artists_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="TOP ARTISTS"
                android:textColor="@color/brand_yellow"
                android:textSize="16sp"
                android:fontFamily="@font/space_mono"
                android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_explore_artists"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:clipToPadding="false"/>

            <!-- Border separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/border_color"
                android:layout_marginTop="8dp"/>

            <!-- Section: TOP TRACKS (vertical) -->
            <TextView
                android:id="@+id/tv_tracks_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="TOP TRACKS"
                android:textColor="@color/brand_yellow"
                android:textSize="16sp"
                android:fontFamily="@font/space_mono"
                android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_explore_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:padding="8dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>