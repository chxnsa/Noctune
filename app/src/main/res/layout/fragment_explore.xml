<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="EXPLORE HUB"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <!-- Genre chips horizontal scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/ll_genre_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>

    </HorizontalScrollView>

    <!-- Label hasil -->
    <TextView
        android:id="@+id/tv_explore_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="TOP ARTISTS"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- RecyclerView hasil explore -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_explore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- Tombol retry -->
    <Button
        android:id="@+id/btn_retry_explore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="RETRY"
        android:backgroundTint="#FFD600"
        android:textColor="#000000"
        android:visibility="gone"/>

</LinearLayout>