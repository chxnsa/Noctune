<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="EXPLORE HUB"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:fontFamily="@font/bebas_neue"
        android:letterSpacing="0.02"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/ll_genre_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_explore_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="TOP ARTISTS"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:fontFamily="@font/bebas_neue"
        android:letterSpacing="0.01"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_explore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btn_retry_explore"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="RETRY CONNECTION"
        android:background="@drawable/brutalist_button_selector"
        android:textColor="#000000"
        android:fontFamily="@font/space_mono"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="0dp"/>
</LinearLayout>