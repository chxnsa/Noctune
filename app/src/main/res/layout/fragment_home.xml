<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Search Bar Bertipe Kotak Kaku Brutalis -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="SEARCH TRACKS, ARTISTS..."
        android:background="@drawable/brutalist_flat_card"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="16dp"
        android:fontFamily="@font/space_mono"
        android:textSize="14sp"
        android:maxLines="1"
        android:inputType="text"
        android:layout_marginBottom="20dp"/>

    <!-- Label section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="NOW TRENDING"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="@font/bebas_neue"
        android:letterSpacing="0.02"/>

    <!-- RecyclerView untuk daftar track -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"/>

    <!-- Tombol Retry -->
    <Button
        android:id="@+id/btn_retry"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="RETRY"
        android:backgroundTint="@color/brand_yellow"
        android:textColor="#000000"
        android:fontFamily="@font/space_mono"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cornerRadius="0dp"/>

</LinearLayout>