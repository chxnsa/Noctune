<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/brutalist_flat_card"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- 1. TRACK INDEX READOUT (Nomor Ranking) -->
    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/brand_yellow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_mono"
        android:layout_gravity="center_vertical"/>

    <!-- Pemisah Grid Antara Nomor dan Gambar (Aksen Mesin Analog) -->
    <View
        android:layout_width="2dp"
        android:layout_height="32dp"
        android:background="@color/border_color"
        android:layout_marginEnd="12dp"/>

    <!-- 2. TRACK THUMBNAIL -->
    <ImageView
        android:id="@+id/iv_chart_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@color/border_color"/>

    <!-- 3. AUDIO PARAMETERS (Info Lagu & Statistik) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical">

        <!-- Judul Track (Sekarang pakai font Chivo yang super bersih dan estetik!) -->
        <TextView
            android:id="@+id/tv_chart_track_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/chivo"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.01"/>

        <!-- Nama Artis -->
        <TextView
            android:id="@+id/tv_chart_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Telemetry Data (Playcount dengan gaya Micro-Badge digital) -->
        <TextView
            android:id="@+id/tv_chart_playcount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_yellow"
            android:textSize="9sp"
            android:fontFamily="@font/space_mono"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            android:background="#161616"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"/>

    </LinearLayout>

    <!-- Aksen Minimalis Sisi Kanan (Penyeimbang Grid) -->
    <View
        android:layout_width="2dp"
        android:layout_height="20dp"
        android:background="@color/border_color"
        android:alpha="0.4"
        android:layout_marginStart="8dp"/>

</LinearLayout>