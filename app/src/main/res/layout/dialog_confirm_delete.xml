<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp"
    android:layout_margin="16dp"
    style="@style/BrutalistButton">

    <!-- Isi Pesan Konfirmasi -->
    <TextView
        android:id="@+id/tv_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ARE YOU SURE YOU WANT TO REMOVE THIS? "
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="@font/space_mono"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="24dp"/>

    <!-- Pilihan Tombol Aksi Siku-Siku -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="CANCEL"
            android:layout_marginRight="4dp"
            app:backgroundTint="@color/brand_red"
            android:textColor="#FFFFFF"
            style="@style/BrutalistButton"/>

        <Button
            android:id="@+id/btn_confirm_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="REMOVE"
            android:layout_marginLeft="4dp"
            app:backgroundTint="@color/brand_yellow"
            android:textColor="#000000"
            style="@style/BrutalistButton"/>
    </LinearLayout>
</LinearLayout>