<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/brutalist_flat_card"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="♫"
        android:textColor="#000000"
        android:textSize="22sp"
        android:gravity="center"
        android:background="@color/brand_yellow"
        android:layout_gravity="center_vertical"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/tv_playlist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/space_mono" />

        <TextView
            android:id="@+id/tv_track_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/space_mono"
            android:text="00 TRACKS REGISTERED"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_delete_playlist"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:text="✕"
        android:textColor="#FFFFFF"
        android:background="@color/brand_red"
        android:textSize="14sp"
        android:gravity="center"
        android:textStyle="bold"
        android:fontFamily="@font/space_mono"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>