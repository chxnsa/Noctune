<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="3dp"> <ImageView
    android:id="@+id/iv_playlist_track_image"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:scaleType="centerCrop"
    android:background="#000000"
    android:layout_gravity="center_vertical"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/tv_playlist_track_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/space_mono"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_playlist_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#4C4546"
            android:textSize="12sp"
            android:fontFamily="@font/space_mono"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_playlist_track_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textColor="#000000"
        android:textSize="12sp"
        android:fontFamily="@font/space_mono"
        android:layout_marginEnd="16dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tv_remove_track"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical"
        android:text="✕"
        android:textColor="#E63329"
        android:background="#F3F3F4"
        android:textSize="13sp"
        android:gravity="center"
        android:fontFamily="@font/space_mono"
        android:textStyle="bold"/>

</LinearLayout>