<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/bg_surface"
    android:gravity="center_vertical">

    <!-- Mini Preview Gambar Cover Playlist -->
    <ImageView
        android:id="@+id/iv_spinner_playlist_cover"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@color/brand_yellow"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <!-- Nama Playlist -->
    <TextView
        android:id="@+id/tv_spinner_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_mono"
        android:text="PLAYLIST NAME" />

</LinearLayout>