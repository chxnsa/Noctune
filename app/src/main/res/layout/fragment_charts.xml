<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 1. HEADER CONTROL BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GLOBAL CHARTS"
            android:textColor="@color/brand_yellow"
            android:textSize="26sp"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.03"/>

        <!-- Indikator Modul Mekanis -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODULE // 02"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="@font/space_mono"
            android:letterSpacing="0.01"/>
    </LinearLayout>

    <!-- Grid Divider Utama -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/border_color"/>

    <!-- 2. COUNTRY SELECTOR RACK OVERLAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:paddingVertical="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">

            <!-- Container chip tempat menampung list negara secara dinamis -->
            <LinearLayout
                android:id="@+id/ll_country_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Grid Divider Kedua -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/border_color"/>

    <!-- 3. PARAMETER READOUT (LABEL NEGARA AKTIF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#121212">

        <!-- Solid Block Accent Khas Jalur Peta Swiss -->
        <View
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:background="@color/brand_red"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_chart_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOP TRACKS — GLOBAL"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="@font/space_mono"
            android:textStyle="bold"
            android:letterSpacing="0.02"/>
    </LinearLayout>

    <!-- Soft Border Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"/>

    <!-- 4. MAIN DATA FEED (RECYCLERVIEW) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_charts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:clipToPadding="false"/>

    <!-- 5. RETRY CONTROLLER (HARD-OFFSET BRUTALIST BUTTON) -->
    <!-- Mempertahankan tipe Button asli agar tidak terjadi ClassCastException di backend -->
    <Button
        android:id="@+id/btn_retry_charts"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:text="RETRY CONNECTION"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.05"
        android:background="@drawable/brutalist_flat_card"
        android:backgroundTint="@color/brand_yellow"
        android:visibility="gone"
        app:backgroundTint="@null"/>

</LinearLayout>