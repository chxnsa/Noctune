<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Poster Block (Kuning Pekat + Vinyl Lingkaran Sempurna) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/brand_yellow"
            android:padding="20dp"
            style="@style/Widget.AppCompat.Light.ActionBar.Solid">

            <!-- Label Atas Khas Braun Hardware Style -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_top="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/border_color"
                    android:text=" GENRE: "
                    android:textColor="@color/bg_surface"
                    android:textSize="12sp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:fontFamily="@font/space_mono"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KRAUTROCK"
                    android:textColor="@color/border_color"
                    android:textSize="18sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/bebas_neue"/>
            </LinearLayout>

            <!-- Vinyl representation (Satu-satunya elemen lingkaran murni) -->
            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_alignParentEnd="true"
                android:layout_top="true"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="-40dp"
                android:background="@drawable/brutalist_flat_card"
                android:backgroundTint="@color/border_color"
                android:alpha="0.12"/>

            <!-- Judul Track Utama Berukuran Raksasa -->
            <TextView
                android:id="@+id/tv_detail_track_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:text="KRAFTWERK"
                android:textColor="@color/border_color"
                android:textSize="48sp"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.02"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/border_color"/>

        <!-- Stats Block Berbentuk Technical Grid Meter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_surface">

            <!-- Listeners Node -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_listeners"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.2M"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp"
                    android:fontFamily="@font/space_mono"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTHLY LISTENERS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_mono"/>
            </LinearLayout>

            <!-- Batas vertikal antar kolom grid -->
            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/border_color"/>

            <!-- Playcount Node -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_detail_playcount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp"
                    android:fontFamily="@font/space_mono"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALBUMS AVAILABLE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_mono"/>
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/border_color"/>

        <!-- Tombol Aksi Utama Favorit Dengan Bayangan Offset Brutalis Kaku -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Layer belakang / Ghost offset shadow -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:background="@color/border_color" />

            <!-- Tombol interaktif asli yang tergeser -->
            <Button
                android:id="@+id/btn_fave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ADD TO LABORATORY FAVES"
                android:backgroundTint="@color/brand_red"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="@font/space_mono"
                app:cornerRadius="0dp"/>
        </FrameLayout>

    </LinearLayout>
</ScrollView>