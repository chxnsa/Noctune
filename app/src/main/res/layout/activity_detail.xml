<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero block — warna kuning sesuai desain Noctune -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#FFD600">

            <!-- Thumbnail lagu -->
            <ImageView
                android:id="@+id/iv_detail_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerInParent="true"
                android:scaleType="centerCrop"
                android:background="#000000"/>

            <!-- Tombol back -->
            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:padding="16dp"
                android:text="← BACK"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"/>

        </RelativeLayout>

        <!-- Info block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#000000">

            <!-- Nama lagu -->
            <TextView
                android:id="@+id/tv_detail_track_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFD600"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <!-- Nama artis -->
            <TextView
                android:id="@+id/tv_detail_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Stats block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1A1A1A"
            android:padding="16dp">

            <!-- Listeners -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_listeners"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD600"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LISTENERS"
                    android:textColor="#666666"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Playcount -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_detail_playcount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD600"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAYS"
                    android:textColor="#666666"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Duration -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD600"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURATION"
                    android:textColor="#666666"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Tombol Save to Favorites -->
        <Button
            android:id="@+id/btn_fave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="♥ SAVE TO FAVORITES"
            android:backgroundTint="#FFD600"
            android:textColor="#000000"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>