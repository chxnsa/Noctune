<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@color/border_color">

            <ImageView
                android:id="@+id/iv_detail_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_album" />

            <!-- Lapisan Proteksi Teks Adaptif -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/overlay_dark" />

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:background="@color/brand_yellow"
                android:text="← BACK"
                android:textColor="#000000"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:fontFamily="@font/space_mono"
                android:textStyle="bold"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_detail_track_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KRAFTWERK"
                    android:textColor="@color/brand_yellow"
                    android:textSize="48sp"
                    android:fontFamily="@font/bebas_neue"
                    android:letterSpacing="0.01"/>

                <TextView
                    android:id="@+id/tv_detail_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RADIO-ACTIVITY"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/space_mono"/>
            </LinearLayout>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/border_color"/>

        <!-- Grid Telemetri Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_surface">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_listeners"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.2M"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:fontFamily="@font/space_mono"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LISTENERS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_mono"/>
            </LinearLayout>

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/border_color"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_detail_playcount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="125K"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:fontFamily="@font/space_mono"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL PLAYS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_mono"/>
            </LinearLayout>

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/border_color"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03:24"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:fontFamily="@font/space_mono"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURATION"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_mono"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/border_color"/>

        <!-- Control Action Rack Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- Tombol Save To Faves -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="5dp"
                        android:background="@color/border_color" />

                    <!-- MENGGUNAKAN SELECTOR & MEMBERIKAN WARNA TEKS DENGAN COLOR SELECTOR (OPSIONAL) -->
                    <Button
                        android:id="@+id/btn_fave"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="♥ SAVE TO FAVES"
                        android:background="@drawable/brutalist_button_selector"
                        app:backgroundTint="@null"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/space_mono"
                        app:cornerRadius="0dp"/>
                </FrameLayout>

                <!-- Tombol YouTube -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="5dp"
                        android:background="@color/border_color" />

                    <Button
                        android:id="@+id/btn_youtube"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="▶ YOUTUBE"
                        android:background="@drawable/brutalist_button_selector"
                        app:backgroundTint="@null"
                        android:textColor="@color/brand_red"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/space_mono"
                        app:cornerRadius="0dp"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Tombol Add To Playlist -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="5dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btn_add_playlist"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="+ ADD TO PLAYLIST"
                    android:background="@drawable/brutalist_button_selector"
                    app:backgroundTint="@null"
                    android:textColor="@color/brand_yellow"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/space_mono"
                    app:cornerRadius="0dp"/>
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/border_color"/>

        <!-- Lyrics Console Ledger -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/bg_main">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/border_color"
                android:text=" LYRICS "
                android:textColor="@color/bg_surface"
                android:textSize="12sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:fontFamily="@font/space_mono"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <ProgressBar
                android:id="@+id/pb_lyrics"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:text="[Loading system lyrics...]"
                android:fontFamily="@font/space_mono"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>